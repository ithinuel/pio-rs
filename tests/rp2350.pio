; Instruction forms exclusive to the RP2350 (PIO version V1), used by
; `tests/pipeline_golden.rs` to check the instruction encodings and the
; detected pio version. The directives exercise the RP2350-only syntax.
.program v1_features
.pio_version rp2350
.clock_div 1.5
.fifo putget
.mov_status irq next set 2
.in 8 left auto
.out 8 right manual 16
.set 3
    wait 0 irq prev 2
    wait 1 irq next 3
    wait 1 irq rel 4
    wait 1 jmppin
    wait 1 jmppin + 3 [4]
    mov rxfifo[y], isr
    mov rxfifo[0], isr
    mov osr, rxfifo[1]
    irq 3 prev
    irq 4 next
    irq 5 rel
    mov pindirs, x
    nop
